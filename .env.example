# ----------------------------------------------------------------------------
# DentalFlow AI — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ----------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / Railway / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dentalflow?sslmode=require"

# Auth — generate a long random string: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Cost circuit-breaker: max AI replies per clinic per rolling 24h
AI_DAILY_CAP="2000"

# WhatsApp provider abstraction.
# PROVIDER options: "mock" (local dev), "meta" (WhatsApp Cloud API), "gupshup"
WHATSAPP_PROVIDER="mock"

# Allow the unsigned mock webhook in production (sandbox/demo only). Leave unset
# in real production — the webhook rejects mock traffic unless this is "true".
ALLOW_MOCK_WEBHOOK=""

# Meta WhatsApp Cloud API (if WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN="dentalflow-verify-token"
# App Secret — REQUIRED to verify inbound webhook signatures (X-Hub-Signature-256)
META_APP_SECRET=""
# Language code of your approved templates in WhatsApp Manager (default "en")
META_TEMPLATE_LANG="en"

# Gupshup (India-first alternative, if WHATSAPP_PROVIDER=gupshup)
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
GUPSHUP_SOURCE_NUMBER=""
# Shared secret sent on inbound callbacks — REQUIRED to authenticate webhooks
GUPSHUP_WEBHOOK_SECRET=""
# JSON map of internal template keys -> Gupshup template IDs, e.g.
# {"followup_day1":"<uuid>","followup_day3":"<uuid>","followup_day7":"<uuid>","reminder_24h":"<uuid>","reminder_2h":"<uuid>","weekly_report":"<uuid>"}
GUPSHUP_TEMPLATE_IDS="{}"

# Razorpay — trial→paid switch. Create a Payment Link with notes.clinicId set,
# enable the payment_link.paid webhook pointing at /api/billing/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=""

# Cron security — protects /api/cron/* endpoints (Vercel Cron sends this)
CRON_SECRET="replace-with-a-random-cron-secret"

# Public base URL (used for links in messages)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
